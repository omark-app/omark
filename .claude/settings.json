{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh", "timeout": 600 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__.*",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/tools/claude-guard/guard.mjs" }]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh workflow run promote:*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge"
    ]
  }
}
