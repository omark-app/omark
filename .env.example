# Every variable the repo reads. Nothing here is a real value; this file is a list, not something any tool loads.
# Where values go: VITE_* in apps/tasks/.env.development.local (Vite reads apps/tasks/, not the repo root);
# the sign-in helper's in .dev.vars at the repo root (git-ignored); repository variables and secrets in GitHub.
# Do not put secrets in this file: use .dev.vars locally and `wrangler pages secret put` on Cloudflare.

# --- Build: read by `vite` and `vite build` in apps/tasks (VITE_* reach the browser bundle) ---
# In dev, apps/tasks/.env.development sets VITE_STORAGE=demo; override in .env.development.local or the shell.

# Where tasks live: onedrive (default), demo (sample tasks in IndexedDB, no sign-in) or fake (in memory, for tests).
VITE_STORAGE=
# Where the demo's "Use it for real" link goes. Empty means https://omark.app.
VITE_REAL_USE_URL=
# Where the first-run screen's "Try the demo" goes. Empty means https://demo.omark.app (/tasks in the standalone Tasks build).
VITE_DEMO_URL=
# OneDrive folder holding the files, inside the app folder. Empty means the app folder's root.
VITE_ONEDRIVE_FOLDER=
# Host names that are production and staging. With neither set every host is local.
VITE_PROD_HOST=
VITE_STAGING_HOST=
# Comma-separated host suffixes that are previews.
VITE_PREVIEW_HOST_SUFFIXES=
# The Google Drive folder (in My Drive) for preview and local builds. Empty means Omark Tasks Dev; production and staging pick theirs by host.
VITE_GOOGLE_FOLDER=
# Build id shown in the footer. CI sets these; locally the git commit and the clock are used.
BUILD_NUMBER=
BUILD_SHA=
BUILD_TIME=

# --- Cloudflare Pages project: the sign-in helper in functions/ (variables and secrets) ---

# Which app the helper serves. Empty means tasks.
OMARK_APP=
# The Entra tenant to sign in through. Empty means consumers.
MSAL_TENANT=
# Secrets. Put the real ones in .dev.vars (local) or `wrangler pages secret put` (Cloudflare).
# Entra app (client) ID.
MSAL_CLIENT_ID=
# Entra client secret.
MSAL_CLIENT_SECRET=
# 32 random bytes, base64: encrypts the session cookie.
COOKIE_KEY=
# Optional: the Google OAuth client. Only a project that has both offers Google Drive (Omark Tasks) and Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub repository variables: read by the workflows (Settings > Secrets and variables > Actions > Variables) ---

# `true` turns on every deploy job.
DEPLOY_ENABLED=
# The one app (apps/omark): Cloudflare Pages projects for production, staging (and PR previews), the demo.
CF_APP_PROJECT=
CF_APP_STAGING_PROJECT=
CF_DEMO_PROJECT=
# Host names that are production and staging (they become VITE_PROD_HOST and VITE_STAGING_HOST), and their
# addresses (the sign-in checks): each URL is https:// followed by its host.
APP_PROD_HOST=
APP_STAGING_HOST=
APP_PROD_URL=
APP_STAGING_URL=
# Comma-separated host suffixes that are PR previews (becomes VITE_PREVIEW_HOST_SUFFIXES).
APP_PREVIEW_HOST_SUFFIXES=
# The Entra tenant the sign-in check expects; must match MSAL_TENANT on the Pages projects. Empty means consumers.
APP_MSAL_TENANT=
# The demo's address, checked after each deploy.
DEMO_URL=
# Where the demo's "Use it for real" link goes (becomes VITE_REAL_USE_URL in the demo build).
REAL_USE_URL=
# The omark.app site (apps/site): its Pages project and its address, checked after each deploy.
CF_SITE_PROJECT=
SITE_URL=

# --- GitHub repository secrets: names only, set in Settings > Secrets and variables > Actions > Secrets ---

# Cloudflare API token and account ID the deploy jobs use.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Tools, read from your shell (never written anywhere) ---

# Todoist API token for tools/todoist-import.
TODOIST_TOKEN=
# Where the real-OneDrive smoke keeps its signed-in browser state. It holds tokens, so keep it outside the repo.
TASKAPP_E2E_STATE=
# The folder the real-OneDrive smoke uses, inside the app folder. Empty means TaskApp-e2e.
TASKAPP_E2E_FOLDER=
# The preview port `pnpm e2e` uses (the demo build takes the next one). Empty means one picked from the checkout's path (4173 in CI).
TASKS_E2E_PORT=
