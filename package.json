{
  "name": "omark-tasks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev": "pnpm --filter omark dev",
    "demo": "pnpm --filter omark demo",
    "e2e": "pnpm -r --if-present e2e && pnpm --filter omark e2e:tasks && pnpm --filter omark e2e:time",
    "dev:signin": "pnpm --filter omark build && pnpm --filter omark exec wrangler pages dev dist --port 5173",
    "e2e:real:login": "pnpm --filter tasks e2e:real:login",
    "e2e:real": "pnpm --filter tasks e2e:real",
    "ship": "node tools/ci/local-deploy.mjs ship",
    "promote": "node tools/ci/local-deploy.mjs promote"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "4.151.1"
  }
}
