{
  "name": "omark-tasks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "e2e": "pnpm -r --if-present e2e",
    "dev:signin": "pnpm --filter tasks build && wrangler pages dev apps/tasks/dist --port 5173",
    "e2e:real:login": "pnpm --filter tasks e2e:real:login",
    "e2e:real": "pnpm --filter tasks e2e:real"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "4.151.1"
  }
}
